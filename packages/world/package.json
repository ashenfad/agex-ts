{
  "name": "@agex-ts/world",
  "version": "0.0.0",
  "description": "A versioned world for agents: sessions as branches of one kvgit repository, with files, a cache, a working directory, forks, checkouts and tags.",
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["agent", "workspace", "versioned", "filesystem", "kvgit", "typescript", "browser"],
  "author": "Adam Ashenfelter",
  "license": "MIT",
  "homepage": "https://github.com/ashenfad/agex-ts/tree/main/packages/world#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashenfad/agex-ts.git",
    "directory": "packages/world"
  },
  "bugs": "https://github.com/ashenfad/agex-ts/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    },
    "./worker": {
      "import": "./dist/worker.js"
    },
    "./worker.node": {
      "import": "./dist/worker.node.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agex-ts/kvgit": "workspace:^",
    "@agex-ts/termish": "workspace:^",
    "@standard-schema/spec": "^1.1.0",
    "ts-blank-space": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fake-indexeddb": "^6.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "4.6.5"
  }
}
