{
  "name": "agex-ts",
  "version": "0.6.0",
  "description": "Agents that act by writing TypeScript and running a shell, in a versioned world: sessions, typed tasks, agent-defined tasks, delegation and folding, on any AI SDK model. The TypeScript counterpart of agex.",
  "keywords": ["agent", "llm", "ai-agent", "typescript", "code-execution", "browser"],
  "author": "Adam Ashenfelter",
  "license": "MIT",
  "homepage": "https://github.com/ashenfad/agex-ts/tree/main/packages/agex-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashenfad/agex-ts.git",
    "directory": "packages/agex-ts"
  },
  "bugs": "https://github.com/ashenfad/agex-ts/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/google": "^4.0.95",
    "@ai-sdk/openai": "^4.0.93",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "4.6.5"
  },
  "dependencies": {
    "@agex-ts/kvgit": "workspace:^",
    "@agex-ts/world": "workspace:^",
    "@ai-sdk/provider": "^4.0.27",
    "@standard-schema/spec": "^1.1.0"
  }
}
